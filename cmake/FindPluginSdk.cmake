if(NOT PLUGIN_SDK_ROOT)
  set(PLUGIN_SDK_ROOT "$ENV{PLUGIN_SDK_ROOT}")
endif()
if(NOT PLUGIN_SDK_ROOT)
  message(FATAL_ERROR "PLUGIN_SDK_ROOT is required when GTANET_WITH_PLUGIN_SDK=ON")
endif()
set(_psdk_inc "${PLUGIN_SDK_ROOT}/plugin_sa")
if(NOT EXISTS "${_psdk_inc}/plugin.h")
  message(FATAL_ERROR "plugin.h not found under ${_psdk_inc}. Point PLUGIN_SDK_ROOT to the selected plugin-sdk checkout.")
endif()
set(PLUGIN_SDK_INCLUDE_DIR "${_psdk_inc}")
message(STATUS "plugin-sdk root: ${PLUGIN_SDK_ROOT}")
